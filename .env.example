# Email Threat Detection Platform - Environment Configuration Template
# Copy this file to .env and configure local variables. Never commit secrets to version control.

# Server binding (Strictly 127.0.0.1 / localhost for terminal and browser safety)
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Agent 2 (Gemini API Adapter)
# Default is false to strictly prevent unauthorized third-party data transmission
ENABLE_GEMINI=false
GEMINI_API_KEY=your_gemini_api_key_here

# Agent 3 (Laya System 1 Decision Model)
# Pinned checkpoint: convaiinnovations/laya-typed-decisions
LAYA_DEVICE=cpu
LAYA_REVISION=reviewed
LAYA_CACHE_DIR=
USE_TF=0

# Security & Safety Guards
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_MIME_DEPTH=10
